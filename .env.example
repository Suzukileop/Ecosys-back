# Copier vers .env.local (non versionné) ou exporter dans le shell avant `mvn spring-boot:run`.
# Ne jamais committer de vraies clés.
#
# Alternative recommandée en dev : backend/src/main/resources/application-local.yml
# + SPRING_PROFILES_ACTIVE=local (déjà dans .gitignore).

SPRING_PROFILES_ACTIVE=local

# Base de données (optionnel — défauts dans application.yml)
# DB_USERNAME=postgres
# DB_PASSWORD=

JWT_SECRET=

# OAuth (Google) — redirect URI must match provider console settings
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/oauth/google/callback

# Accès depuis le réseau local (même Wi‑Fi) — remplacer 192.168.x.x par votre IP (ipconfig)
# FRONTEND_URL=http://192.168.1.42:3000
# STORAGE_PUBLIC_BASE_URL=http://192.168.1.42:8080
# CORS_EXTRA_ORIGINS=http://192.168.1.42:3000

# Stockage Cloudflare R2 (optionnel en local)
# R2_ENABLED=false

# ── Production / préproduction ──────────────────────────────────────────────
# Avec SPRING_PROFILES_ACTIVE=prod (ou production / staging), le serveur REFUSE de démarrer
# si JWT_SECRET ou DB_PASSWORD gardent leur valeur par défaut versionnée (voir JwtSecretGuard).
# Générer un secret : openssl rand -base64 48
# SPRING_PROFILES_ACTIVE=prod
# JWT_SECRET=<au moins 32 octets aléatoires>
# DB_USERNAME=<utilisateur dédié, pas postgres>
# DB_PASSWORD=<mot de passe fort>
# FRONTEND_URL=https://<domaine du frontend>
# Pool de connexions (défauts : 10 max, 2 au repos). Taille ≈ max_connections Postgres / nb d'instances.
# DB_POOL_MAX_SIZE=20
# DB_POOL_MIN_IDLE=5
# DB_POOL_LEAK_DETECTION_MS=60000
